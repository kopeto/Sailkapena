; ============================================================
; installer.iss - Inno Setup script for SailkapenaHG
; Compile with: iscc installer.iss  (or from the Inno Setup IDE)
; Requires build_windows.bat to have been run first.
; ============================================================

#define AppName      "SailkapenaHG"
#define AppVersion   "0.1"
#define AppPublisher "Ander"
#define AppExeName   "SailkapenaHG.exe"
; Path to the build output directory (relative to this .iss file)
#define BuildDir     "..\build_windows\Release"
; For Ninja/MinGW generators the exe is placed directly in build_windows
; build_windows.bat normalises this by copying it into Release\

[Setup]
AppId={{A3F7B1C2-4D8E-4F0A-9B6C-1E2D3A4B5C6D}
AppName={#AppName}
AppVersion={#AppVersion}
AppPublisher={#AppPublisher}
DefaultDirName={autopf}\{#AppName}
DefaultGroupName={#AppName}
AllowNoIcons=yes
; Installer icon (optional, uncomment if you have an .ico file)
; SetupIconFile=..\img\icon.ico
OutputDir=..\installer_output
OutputBaseFilename=SailkapenaHG_Setup_{#AppVersion}
Compression=lzma2/ultra64
SolidCompression=yes
WizardStyle=modern
ArchitecturesInstallIn64BitMode=x64
PrivilegesRequiredOverridesAllowed=dialog

[Languages]
; Name: "english"; MessagesFile: "compiler:Default.isl"
; Basque (Euskera) is a community translation - not bundled with Inno Setup.
; Download Basque.isl from https://jrsoftware.org/files/istrans/
; and place it in: <Inno Setup install dir>\Languages\Basque.isl
; Then uncomment the line below:
Name: "basque"; MessagesFile: "compiler:Languages\Basque.isl"

[Tasks]
Name: "desktopicon";    Description: "{cm:CreateDesktopIcon}";    GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked
Name: "quicklaunchicon"; Description: "{cm:CreateQuickLaunchIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked; OnlyBelowVersion: 6.1

[Files]
; Main executable
Source: "{#BuildDir}\{#AppExeName}"; DestDir: "{app}"; Flags: ignoreversion

; All DLLs and files copied by windeployqt
Source: "{#BuildDir}\*.dll";   DestDir: "{app}"; Flags: ignoreversion recursesubdirs
Source: "{#BuildDir}\*.json";  DestDir: "{app}"; Flags: ignoreversion skipifsourcedoesntexist
Source: "{#BuildDir}\plugins\*"; DestDir: "{app}\plugins"; Flags: ignoreversion recursesubdirs skipifsourcedoesntexist
Source: "{#BuildDir}\qml\*";     DestDir: "{app}\qml";     Flags: ignoreversion recursesubdirs skipifsourcedoesntexist
Source: "{#BuildDir}\translations\*"; DestDir: "{app}\translations"; Flags: ignoreversion recursesubdirs skipifsourcedoesntexist
Source: "{#BuildDir}\resources\*";    DestDir: "{app}\resources";    Flags: ignoreversion recursesubdirs skipifsourcedoesntexist
Source: "{#BuildDir}\styles\*";       DestDir: "{app}\styles";       Flags: ignoreversion recursesubdirs skipifsourcedoesntexist

; Visual C++ Runtime (if needed - uncomment if using MSVC and vcredist is not present)
; Source: "vcredist_x64.exe"; DestDir: {tmp}; Flags: deleteafterinstall

[Icons]
Name: "{group}\{#AppName}";           Filename: "{app}\{#AppExeName}"
Name: "{group}\Uninstall {#AppName}"; Filename: "{uninstallexe}"
Name: "{autodesktop}\{#AppName}";      Filename: "{app}\{#AppExeName}"; Tasks: desktopicon

[Run]
; Install VC++ Runtime if needed (uncomment if you include it)
; Filename: "{tmp}\vcredist_x64.exe"; Parameters: "/quiet /norestart"; StatusMsg: "Installing VC++ Runtime..."; Flags: waituntilterminated

Filename: "{app}\{#AppExeName}"; Description: "{cm:LaunchProgram,{#AppName}}"; Flags: nowait postinstall skipifsilent

[UninstallDelete]
; Clean up files generated by the app (tmp results, etc.)
Type: filesandordirs; Name: "{app}"

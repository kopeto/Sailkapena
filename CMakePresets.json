{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (Windows)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release (Windows)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "debug-linux",
      "displayName": "Debug (Linux)",
      "generator": "Unix Makefiles",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release-linux",
      "displayName": "Release (Linux)",
      "generator": "Unix Makefiles",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "displayName": "Build Debug (Windows)",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "displayName": "Build Release (Windows)",
      "configurePreset": "release"
    },
    {
      "name": "debug-linux",
      "displayName": "Build Debug (Linux)",
      "configurePreset": "debug-linux"
    },
    {
      "name": "release-linux",
      "displayName": "Build Release (Linux)",
      "configurePreset": "release-linux"
    }
  ]
}

  "buildPresets": [
    {
      "name": "debug",
      "displayName": "Build Debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "displayName": "Build Release",
      "configurePreset": "release"
    }
  ]
}
